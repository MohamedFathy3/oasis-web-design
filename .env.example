# Copy to .env; never commit the real .env file.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=replace-with-a-new-long-random-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL connection (use MYSQL_URL instead if your host provides one)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=viralzoom
MYSQL_CONNECTION_LIMIT=10

# Prisma (required by db:migrate and db:seed)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/viralzoom"
# Persistent uploads directory
DATA_DIR=./data
PUBLIC_SITE_URL=https://viralzoom.agency

# Hostinger SMTP (set these in the production environment; never commit real credentials)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@viralzoom.agency
SMTP_PASSWORD=
CONTACT_EMAIL=info@viralzoom.agency
