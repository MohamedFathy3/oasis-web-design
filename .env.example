# Copy to .env; never commit the real .env file.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=replace-with-a-new-long-random-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL database created/imported from database/mysql-schema.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=viralzoom
MYSQL_USER=viralzoom_user
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_POOL_SIZE=10

# Persistent local folder for user-uploaded media only
DATA_DIR=./data
# Verified public HTTPS origin; override for staging or another deployment.
PUBLIC_SITE_URL=https://viralzoom.tech
