generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model SiteSettings {
  id       Int    @id @db.UnsignedTinyInt
  brand    String @db.LongText
  hero     String @db.LongText
  sections String @db.LongText
  contact  String @db.LongText
  content  String @db.LongText

  @@map("site_settings")
}

model ContentItem {
  collection String @db.VarChar(32)
  itemId     String @map("item_id") @db.VarChar(191)
  position   Int
  content    String @db.LongText

  @@id([collection, itemId])
  @@index([collection, position], map: "content_items_order")
  @@map("content_items")
}

model ContactMessage {
  id        String   @id @db.VarChar(36)
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  subject   String   @db.VarChar(160)
  message   String   @db.LongText
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([isRead, createdAt], map: "contact_messages_inbox")
  @@map("contact_messages")
}
